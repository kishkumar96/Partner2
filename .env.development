# Development Environment Configuration
NEXT_PUBLIC_APP_NAME="Climate Risk Dashboard - Dev"
NEXT_PUBLIC_APP_VERSION="1.0.0-dev"
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# Analytics - Disabled in dev
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false

# Map Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=-15.3767
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=166.9592
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7

# API Configuration - Local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api
API_SECRET_KEY=dev-secret-key

# Database - Local
DATABASE_URL=postgresql://postgres:climate_secure_2026@localhost:5432/climate_risk

# Redis - Local
REDIS_URL=redis://:redis_secure_2026@localhost:6379

# Tileserver - Local
TILESERVER_URL=http://localhost:7800
NEXT_PUBLIC_TILESERVER_URL=http://localhost:7800

# Feature Flags - All enabled in dev
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=true
NEXT_PUBLIC_SHOW_PERFORMANCE_METRICS=true

# Data Sources
NEXT_PUBLIC_DATA_UPDATE_INTERVAL=300000
NEXT_PUBLIC_CACHE_TTL=3600

# Security - Relaxed in dev
NEXT_PUBLIC_CSP_ENABLED=false
NEXT_PUBLIC_RATE_LIMIT_ENABLED=false

# Ollama (Local AI Models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT=60000
USE_ENSEMBLE=true
USE_OLLAMA_CODE_REVIEW=true
USE_OLLAMA_DOCS=true
USE_OLLAMA_TESTS=true
NEXT_PUBLIC_BASE_PATH=
