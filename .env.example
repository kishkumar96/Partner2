# Copy this file to .env.local (gitignored) for local development, or set
# these as real environment variables in your hosting provider for
# staging/production. Never commit filled-in .env.development/.env.staging/
# .env.production files — those are gitignored on purpose.

# Application Configuration
NEXT_PUBLIC_APP_NAME="Climate Risk Dashboard"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_ENVIRONMENT=development
# Base path configuration (empty = root, '/partner2' = subdirectory)
NEXT_PUBLIC_BASE_PATH=

NODE_ENV=development

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Error Tracking (Optional - Add Sentry DSN for error monitoring)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_AUTH_TOKEN=

# Map Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=-15.3767
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=166.9592
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7

# API Configuration
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api
# API_SECRET_KEY=

# Partner API - middleware backend
NEXT_PUBLIC_ENABLE_PARTNER_API=true
PARTNER_API_ENABLED=true
PARTNER_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PARTNER_API_COUNTRIES=VU,WS,TO,CK
PARTNER_API_COUNTRIES=VU,WS,TO,CK
NEXT_PUBLIC_PARTNER_API_STRICT_COUNTRIES=VU
PARTNER_API_STRICT_COUNTRIES=VU

# Database (only needed if this app talks to Postgres directly)
# DATABASE_URL=postgresql://user:password@localhost:5432/climate_risk

# Redis
# REDIS_URL=redis://:password@localhost:6379

# Tileserver
# TILESERVER_URL=http://localhost:7800
# NEXT_PUBLIC_TILESERVER_URL=http://localhost:7800

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=false
NEXT_PUBLIC_SHOW_PERFORMANCE_METRICS=false

# Data Sources
NEXT_PUBLIC_DATA_UPDATE_INTERVAL=300000
NEXT_PUBLIC_CACHE_TTL=3600

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_RATE_LIMIT_ENABLED=false

# Ollama (Local AI Models) - Optional
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT=60000
USE_ENSEMBLE=true
USE_OLLAMA_CODE_REVIEW=false
USE_OLLAMA_DOCS=false
USE_OLLAMA_TESTS=false

# Country Access Control (optional — omit or leave blank to keep a country public)
# Lock this deployment to a single country route/data scope.
# Accepts code or slug: VU / vanuatu, WS / samoa, TO / tonga, CK / cook-islands
# TENANT_COUNTRY=VU
#
# Comma-separated public countries. Any country not listed here is protected.
# In local development, leaving this unset keeps all countries public.
# COUNTRY_PUBLIC_COUNTRIES=VU,WS,TO,CK
#
# Set a password to restrict access to a country dashboard via /[country]/login
# COUNTRY_AUTH_SECRET=replace-with-long-random-secret
# COUNTRY_PASSWORD_VU=your-vanuatu-password
# COUNTRY_PASSWORD_WS=your-samoa-password
# COUNTRY_PASSWORD_TO=your-tonga-password
# COUNTRY_PASSWORD_CK=your-cook-islands-password
#
# Require Redis-backed distributed controls (recommended for production)
# AUTH_REQUIRE_REDIS=true
#
# Optional: when true, logout rotates country session version and invalidates all
# existing sessions for that country.
# COUNTRY_AUTH_ROTATE_ON_LOGOUT=false

# Staging-only flags (reference — set directly in your hosting provider, not here)
# NEXT_PUBLIC_SHOW_STAGING_BANNER=true
# NEXT_PUBLIC_ALLOW_TEST_DATA=true
