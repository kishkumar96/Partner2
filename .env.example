# Application Configuration
NEXT_PUBLIC_APP_NAME="Climate Risk Dashboard"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=production

# Analytics (Optional - Uncomment and add your tracking IDs)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Error Tracking (Optional - Add Sentry DSN for error monitoring)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=your-auth-token

# Map Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=-15.3767
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=166.9592
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7

# API Configuration (if you add backend APIs)
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
# API_SECRET_KEY=your-secret-key

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Data Sources
NEXT_PUBLIC_DATA_UPDATE_INTERVAL=300000
NEXT_PUBLIC_CACHE_TTL=3600

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_RATE_LIMIT_ENABLED=false

# Ollama (Local AI Models) - Optional
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT=60000
USE_ENSEMBLE=true
USE_OLLAMA_CODE_REVIEW=false
USE_OLLAMA_DOCS=false
USE_OLLAMA_TESTS=false
