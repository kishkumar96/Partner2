{
  "name": "climate-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "build:production": "cross-env NODE_ENV=production next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:bundle": "cross-env ANALYZE=true next build && open .next/analyze/client.html",
    "bundle-analyzer": "cross-env ANALYZE=true next build",
    "lighthouse": "lighthouse http://localhost:3002 --view",
    "lighthouse:ci": "lighthouse http://localhost:3002 --output=json --output-path=./lighthouse-report.json",
    "perf:lighthouse": "lhci autorun --config=lighthouserc.json",
    "perf:playwright": "playwright test --config=playwright.config.ts",
    "perf:ci": "bash scripts/perf-ci.sh",
    "audit": "npm audit --audit-level=moderate",
    "prepare": "husky install || true",
    "ollama:review": "node scripts/ollama-review.js",
    "ollama:fast": "SKIP_TRIVIAL=true PARALLEL_BATCH=10 USE_ENSEMBLE=false node scripts/ollama-review.js",
    "ollama:staged": "node scripts/ollama-review.js --staged",
    "ollama:parallel": "PARALLEL_BATCH=10 node scripts/ollama-review.js",
    "ollama:components": "node scripts/ollama-review.js src/components/",
    "ollama:docs": "node scripts/ollama-docs.js",
    "ollama:tests": "node scripts/ollama-tests.js",
    "ollama:commit": "node scripts/ollama-commit.js",
    "ollama:check": "node scripts/ollama-check.js"
  },
  "dependencies": {
    "@deck.gl/extensions": "^9.2.11",
    "@deck.gl/mapbox": "^9.2.11",
    "@sentry/nextjs": "^10.38.0",
    "chart.js": "^4.5.1",
    "deck.gl": "^9.2.11",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "georaster": "^1.6.0",
    "geotiff": "^3.0.0",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.554.0",
    "maplibre-gl": "^5.13.0",
    "next": "16.0.4",
    "pg": "^8.13.1",
    "react": "19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.0",
    "redis": "^5.10.0",
    "web-vitals": "^4.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.1.4",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/file-saver": "^2.0.7",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^16.0.0",
    "lighthouse": "^12.2.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@typescript-eslint/typescript-estree": "8.54.0",
    "@typescript-eslint/utils": "8.54.0"
  }
}
