apiVersion: v1
kind: Secret
metadata:
  name: climate-dashboard-secrets
  namespace: production
type: Opaque
stringData:
  database-url: "postgresql://user:password@postgres-host:5432/climate_risk"
  redis-url: "redis://:password@redis-host:6379"
  sentry-dsn: "https://xxx@xxx.ingest.sentry.io/xxx"
  # Add more secrets as needed
