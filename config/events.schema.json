{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "hazardId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": ["lat", "lng"],
            "additionalProperties": false
          },
          "bbox": {
            "type": "array",
            "items": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "additionalItems": false,
            "minItems": 4,
            "maxItems": 4
          },
          "trackFile": {
            "type": "string",
            "minLength": 1
          },
          "forecastFile": {
            "type": "string",
            "minLength": 1
          },
          "isDefault": {
            "default": false,
            "type": "boolean"
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9 ]*$"
            }
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "date",
          "hazardId",
          "location",
          "bbox",
          "isDefault",
          "aliases",
          "enabled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["country", "events"],
  "additionalProperties": false
}
