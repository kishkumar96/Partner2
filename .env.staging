# Staging Environment Configuration
NEXT_PUBLIC_APP_NAME="Climate Risk Dashboard - Staging"
NEXT_PUBLIC_APP_VERSION="1.0.0-staging"
NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com
NEXT_PUBLIC_BASE_PATH=/partner2

# Environment
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=staging

# Analytics - Staging specific tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-STAGING-XXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=staging.yourdomain.com

# Error Tracking - Staging environment
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
SENTRY_AUTH_TOKEN=your-staging-auth-token

# Map Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=-15.3767
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=166.9592
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://staging-api.yourdomain.com
API_SECRET_KEY=staging-secret-key

# Partner API - Deployed endpoint
NEXT_PUBLIC_ENABLE_PARTNER_API=true
PARTNER_API_ENABLED=true
PARTNER_API_BASE_URL=https://pacific-disaster-api.spc.int
NEXT_PUBLIC_PARTNER_API_COUNTRIES=VU,WS,TO,CK
PARTNER_API_COUNTRIES=VU,WS,TO,CK
NEXT_PUBLIC_PARTNER_API_STRICT_COUNTRIES=VU
PARTNER_API_STRICT_COUNTRIES=VU

# Database - Staging
DATABASE_URL=postgresql://postgres:password@staging-db.yourdomain.com:5432/climate_risk_staging

# Redis - Staging
REDIS_URL=redis://:password@staging-redis.yourdomain.com:6379

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=true

# Data Sources
NEXT_PUBLIC_DATA_UPDATE_INTERVAL=300000
NEXT_PUBLIC_CACHE_TTL=1800

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_RATE_LIMIT_ENABLED=true

# Staging-specific flags
NEXT_PUBLIC_SHOW_STAGING_BANNER=true
NEXT_PUBLIC_ALLOW_TEST_DATA=true
