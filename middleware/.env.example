# Copy this file to .env and fill values

POSTGRESDB_USER=postgres
POSTGRESDB_ROOT_PASSWORD=change_me
POSTGRESDB_DATABASE=partner-api
POSTGRESDB_LOCAL_PORT=5432
POSTGRESDB_DOCKER_PORT=5432

POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_SECRET_KEY=change_me

CORS_ALLOW_ALL_ORIGINS=false

# Hazard catalogue Zarr store (hazard_tiles). Leave empty to read data/hazard_catalog.zarr from disk,
# or point it at Wasabi. The keys are the same names as the project's wasabi.env.
# HAZARD_CATALOG_STORE=s3://spc-zarr-file/hazard_catalog.zarr
# HAZARD_CATALOG_CACHE_DIR=/code/data/.hazard_cache
# WASABI_ENDPOINT_URL=https://s3.ap-southeast-2.wasabisys.com
# AWS_DEFAULT_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
